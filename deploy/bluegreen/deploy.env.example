# Deploy options for necropsy-deploy, installed as /etc/necropsy/deploy.env
# (root-owned, and the program refuses it if anyone else can write to it).
# Plain KEY=VALUE lines only: the file is parsed, never executed. install-system.sh
# writes NECROPSY_REPO; the rest are optional.

# The repository to build releases from, https only.
#NECROPSY_REPO=https://github.com/owner/necropsy

# The only branch whose commits are ever built: main for production, dev for a
# dev server. install-system.sh writes it (--branch). Default main.
#NECROPSY_BRANCH=main

# Host address the proxy container is published on. The default, 127.0.0.1,
# is for a reverse proxy on this host. Use 0.0.0.0 (or this host's address)
# when the reverse proxy is elsewhere, for example in front of a VM. Then:
#   - firewall the port so only your proxy can reach it. Docker's own iptables
#     rules skip ufw and firewalld, so use the DOCKER-USER chain or a firewall
#     outside the VM (see docs/docker.md).
#   - set NECROPSY_EDGE_TRUSTED to your proxy's address.
# A deploy recreates the proxy container when this or NECROPSY_PORT changes.
#NECROPSY_BIND=127.0.0.1

# Host port the proxy container is published on. Point your own reverse proxy
# here. Default 8080.
#NECROPSY_PORT=8080

# Private subnet the containers use. Change it only if it clashes with a
# network you already have. Default 172.30.30.0/24.
#NECROPSY_SUBNET=172.30.30.0/24

# How your own reverse proxy appears to the proxy container, comma-separated
# addresses or ranges. The client address your proxy puts in X-Real-IP is only
# believed from these. Default: the subnet's gateway plus 127.0.0.1, which is
# right when your proxy runs on this host and connects to NECROPSY_PORT. For a
# proxy on another host, its own address, like 10.0.0.5.
#NECROPSY_EDGE_TRUSTED=172.30.30.1,127.0.0.1

# Seconds the old color keeps finishing requests after traffic moves. Default 15.
#DRAIN_SECONDS=15

# Seconds to wait for a new color to report healthy. Default 90.
#HEALTH_TIMEOUT=90
