# Runs the spawner for container-backed live puzzles (docs/range.md), for one
# stack. @NAME@ is the stack's name: "necropsy" for production or the only
# stack, "necropsy-dev" for a dev stack on the same host. Install with
#   sed 's/@NAME@/necropsy/g' necropsy-spawner.service.in > /etc/systemd/system/necropsy-spawner.service
# The program is shared, at /usr/local/bin/necropsy-spawner; each stack has its
# own allowlist (/etc/@NAME@/images.toml), socket and lab directory.

[Unit]
Description=necropsy range spawner (@NAME@)
Documentation=https://github.com/urashyl/necropsy
After=docker.service
Requires=docker.service

[Service]
Type=simple
ExecStart=/usr/local/bin/necropsy-spawner
Environment=SPAWNER_IMAGES=/etc/@NAME@/images.toml
Environment=SPAWNER_SOCKET=/run/@NAME@/spawner.sock
Environment=SPAWNER_RANGE_DIR=/run/@NAME@/range
# The group of the web server inside its container (the image's "nonroot").
Environment=SPAWNER_SOCKET_GID=65532
EnvironmentFile=-/etc/@NAME@/spawner.env

# /run/@NAME@ is created here, and kept when the spawner restarts: the web
# container has it mounted, and instances still running keep their sockets.
RuntimeDirectory=@NAME@
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes

Restart=on-failure
RestartSec=3
KillSignal=SIGINT
# Containers outlive the spawner on purpose; it finds them again on start.

# It needs root to hand each instance's directory to the instance's user and
# to use Docker, and nothing else on the machine.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run/@NAME@
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE
LockPersonality=yes
RestrictRealtime=yes

[Install]
WantedBy=multi-user.target
