#!/usr/bin/env bash
# A fake docker for the updater's tests: `docker run` "builds" the spawner by
# copying a marker file from the commit's tree. FAKE_DIR/build_fail makes it fail.
d="$(cat "$(dirname "$0")/state_dir")"
echo "docker $*" >> "$d/calls"
[ "$1" = run ] || exit 0
[ ! -e "$d/build_fail" ] || { echo "fake build failed" >&2; exit 1; }
src="" out=""
while [ $# -gt 0 ]; do
  case "$1" in
    -v) case "$2" in *:/src:ro) src="${2%:/src:ro}" ;; *:/out) out="${2%:/out}" ;; esac; shift 2 ;;
    *) shift ;;
  esac
done
cp "$src/crates/necropsy-spawner/marker.txt" "$out/necropsy-spawner"
