# necropsy settings. Lines starting with # are unset and use the program's
# default. The server reads real environment variables only; it does not load
# a .env file by itself.
#
# In Docker (docs/docker.md) this same file is used, except that the listen
# address, client IP header, trusted proxies, packs and database path are fixed
# by the container and ignored here.
#
# Installed service: deploy/install.sh copies this file to
#   ~/.config/necropsy/necropsy.env  (private, mode 0600; never overwritten)
# and the systemd unit loads it. Restart after editing:
#   systemctl --user restart necropsy
#
# Local development:
#   cp .env.example .env     # .env is gitignored; it can hold the SMTP password
#   set -a; . ./.env; set +a
#   cargo run -p necropsy-web

# Address to listen on. Keep it on loopback when a reverse proxy faces the
# internet.
#NECROPSY_ADDR=127.0.0.1:8080

# Public origin, used in emails and links. Cookies are only marked Secure when
# this starts with https://
#NECROPSY_BASE_URL=https://necropsy.urashyl.dev

# Behind a reverse proxy, the header your proxy uses to pass the client address,
# so rate limits see real clients instead of the proxy. The proxy must always
# overwrite it (Caddy: header_up X-Real-IP {remote_host}), otherwise
# clients can set it themselves. Unset uses the connecting address. For a list
# header such as X-Forwarded-For the last entry is used.
#NECROPSY_CLIENT_IP_HEADER=X-Real-IP

# Only believe that header when the connection comes from these addresses
# (comma-separated IPs or CIDR ranges, IPv4 or IPv6). Set this to your proxy's
# address so nobody else can spoof the header, for example when your proxy runs on
# the same machine:
#NECROPSY_TRUSTED_PROXIES=127.0.0.1,::1
# Without it, the header is believed from any connection and the server logs a
# warning at startup.

# Live puzzles: each player gets a server of their own at
# https://<random>.<this domain>. Your reverse proxy must send the wildcard
# (*.necropsy.urashyl.dev) to this same server, with the Host header unchanged.
# Unset turns live puzzles off and hides them. See docs/live.md. For local
# runs, *.localhost resolves to 127.0.0.1 in browsers and curl:
#NECROPSY_LIVE_DOMAIN=necropsy.urashyl.dev
#NECROPSY_LIVE_DOMAIN=necropsy.localhost:8080
# Only if your proxy cannot pass Host through: a header holding the original
# host. Believed only from NECROPSY_TRUSTED_PROXIES.
#NECROPSY_LIVE_HOST_HEADER=X-Forwarded-Host

# Container-backed live puzzles (docs/range.md): the range VM that runs them, and
# this site's token there. Set both or neither; without them those puzzles are
# hidden. deploy/install-site.sh sets these.
#NECROPSY_RANGE_URL=http://192.168.100.50:9400
#NECROPSY_RANGE_TOKEN=

# Cloudflare Turnstile, asked when creating an account and when starting a live
# instance (docs/accounts.md). Set both or neither; without them no captcha is
# asked and the server warns at startup.
#NECROPSY_TURNSTILE_SITE_KEY=
#NECROPSY_TURNSTILE_SECRET=

# Email. Without a host, registration and password reset are closed.
#NECROPSY_SMTP_HOST=smtp.example.com
#NECROPSY_SMTP_PORT=587
#NECROPSY_SMTP_TLS=starttls
#NECROPSY_SMTP_USERNAME=
#NECROPSY_SMTP_PASSWORD=
#NECROPSY_SMTP_FROM="necropsy <no-reply@example.com>"

# Override where packs and the database live (the unit sets sensible defaults).
#NECROPSY_PACKS=
#NECROPSY_DB=

# Local development only: print emails to the server log instead of sending
# them, recipient and links included. Never set this in production.
#NECROPSY_DEV_MAIL_LOG=1

# Log verbosity.
#RUST_LOG=necropsy_web=info

# Log every request (method, path and status, never the query string). Off by
# default.
#NECROPSY_LOG_REQUESTS=1
